<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 与首版一致的稳定主题：全屏由 MainActivity 的 systemUiVisibility 实现，
         这里不引入任何新属性，避免不同 Android 版本的主题解析差异 -->
    <style name="AppTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">#eef1f5</item>
        <item name="android:colorPrimary">#2f6fed</item>
        <item name="android:colorAccent">#2f6fed</item>
        <item name="android:statusBarColor">#eef1f5</item>
        <item name="android:navigationBarColor">#eef1f5</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>